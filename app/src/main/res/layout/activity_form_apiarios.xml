<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5F0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/btnVolverApiarios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Volver"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nuevo apiario"
                android:textColor="#2F3A32"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ingresa la información del apiario"
                android:textColor="#747474"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Nombre del apiario"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNombreApiario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ej: Apiario Los Aromos"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Ubicación"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUbicacion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ej: Doñihue"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Cantidad de colmenas"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCantidadColmenas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ej: 20"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="number"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Descripción"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:gravity="top|start"
                android:hint="Describe el apiario"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <Button
                android:id="@+id/btnGuardarApiario"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="30dp"
                android:text="Guardar apiario"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#2F3A32" />

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/bottom_nav" />

</LinearLayout>
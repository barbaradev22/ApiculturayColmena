<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5F0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/btnVolverApicultores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Volver"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp" />

            <TextView
                android:id="@+id/txtTituloApicultor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nuevo apicultor"
                android:textColor="#2F3A32"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ingresa la información del apicultor"
                android:textColor="#747474"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Nombre"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNombreApicultor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ej: Carlos Muñoz"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Teléfono"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTelefono"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ej: +56 9 1234 5678"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="phone"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Correo"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ej: correo@apicola.cl"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Especialidad"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEspecialidad"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ej: Producción de miel"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <Button
                android:id="@+id/btnGuardarApicultor"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="30dp"
                android:text="Guardar apicultor"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#2F3A32" />

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/bottom_nav" />

</LinearLayout>
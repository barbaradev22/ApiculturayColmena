<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5F0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/btnVolverColmenas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volver"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp" />

            <TextView
                android:id="@+id/txtTituloColmena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nueva colmena"
                android:textColor="#2F3A32"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ingresa la información de la colmena"
                android:textColor="#747474"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Nombre de la colmena"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCodigoColmena"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ej: Colmena 04"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Tipo de colmena"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTipoColmena"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Ej: Langstroth"
                android:textColor="#252525"
                android:textColorHint="#747474"
                android:inputType="textCapSentences"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:backgroundTint="#B7B4AC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Apiario"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spApiarioColmena"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#B7B4AC" />

            <TextView
                android:id="@+id/txtEstadoColmena"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Estado"
                android:textColor="#2F3A32"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/spEstadoColmena"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#B7B4AC"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnGuardarColmena"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="30dp"
                android:text="Guardar colmena"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#2F3A32" />

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/bottom_nav" />

</LinearLayout>
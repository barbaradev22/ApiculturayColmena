<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/txtCodigoColmena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Colmena 01"
        android:textColor="#2F3A32"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtTipoColmena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="Tipo: Langstroth"
        android:textColor="#5F5F5F"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtApiarioColmena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Apiario: Apiario Los Aromos"
        android:textColor="#5F5F5F"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtEstadoColmena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Estado: Activa"
        android:textColor="#5F5F5F"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditarColmena"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Editar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#2F3A32" />

        <Button
            android:id="@+id/btnEliminarColmena"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Eliminar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:backgroundTint="#8A4A4A" />

    </LinearLayout>

</LinearLayout>